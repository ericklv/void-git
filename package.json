{
  "name": "void-git",
  "displayName": "Void Git",
  "description": "IntelliJ-style git log: full commit graph, cherry-pick, reword, interactive rebase, worktrees.",
  "version": "0.2.0",
  "publisher": "elazon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ericklv/void-git.git"
  },
  "bugs": {
    "url": "https://github.com/ericklv/void-git/issues"
  },
  "homepage": "https://github.com/ericklv/void-git#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1b2335",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "git",
    "graph",
    "log",
    "history",
    "cherry-pick",
    "rebase",
    "interactive rebase",
    "reword",
    "worktree",
    "intellij"
  ],
  "pricing": "Free",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "voidGit.open",
        "title": "Open Void Git in Editor",
        "category": "Void Git",
        "icon": "$(git-merge)"
      },
      {
        "command": "voidGit.show",
        "title": "Show Void Git Panel",
        "category": "Void Git",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "voidGit.refresh",
        "title": "Refresh",
        "category": "Void Git",
        "icon": "$(refresh)"
      },
      {
        "command": "voidGit.selectRepo",
        "title": "Select Repository",
        "category": "Void Git",
        "icon": "$(repo)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "voidGitPanel",
          "title": "Void Git",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "voidGitPanel": [
        {
          "type": "webview",
          "id": "voidGit.view",
          "name": "Log"
        }
      ]
    },
    "configuration": {
      "title": "Void Git",
      "properties": {
        "voidGit.pageSize": {
          "type": "number",
          "default": 1000,
          "description": "Number of commits loaded per page."
        },
        "voidGit.followActiveEditor": {
          "type": "boolean",
          "default": true,
          "description": "Switch Void Git to the repository of the active file."
        }
      }
    },
    "menus": {
      "scm/title": [
        {
          "command": "voidGit.open",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "voidGit.selectRepo",
          "when": "view == voidGit.view",
          "group": "navigation@1"
        },
        {
          "command": "voidGit.open",
          "when": "view == voidGit.view",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package",
    "publish": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.2.0",
    "ovsx": "^1.4.0",
    "typescript": "^5.6.0"
  }
}
